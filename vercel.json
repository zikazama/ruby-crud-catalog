{
  "version": 2,
  "buildCommand": "bundle install --deployment && rails assets:precompile",
  "devCommand": "rails s",
  "env": {
    "RAILS_ENV": "production"
  },
  "functions": {
    "api/[...route].rb": {
      "runtime": "ruby3.3",
      "memory": 3008,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/[...route]"
    }
  ]
}
