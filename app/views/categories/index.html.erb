<div class="header">
  <div class="container">
    <h1>Catalog Dashboard</h1>
    <div class="user-info">
      Logged in as: <strong><%= current_user.username %></strong>
      | <%= link_to "Logout", logout_path, method: :delete, style: "color: white; text-decoration: underline;" %>
    </div>
  </div>
</div>

<div class="container">
  <div class="nav">
    <%= link_to "Dashboard", dashboard_path %>
    <%= link_to "Categories", categories_path %>
    <%= link_to "Products", products_path %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-error"><%= flash[:alert] %></div>
  <% end %>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Categories Management</h2>
    <%= link_to "+ New Category", new_category_path, class: "btn btn-primary" %>
  </div>

  <div class="card">
    <% if @categories.any? %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Publish</th>
            <th>Products Count</th>
            <th>Created At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td><code style="font-size: 11px;"><%= category.id.first(8) %>...</code></td>
              <td><strong><%= category.name %></strong></td>
              <td>
                <span class="badge badge-<%= category.publish == 1 ? 'yes' : 'no' %>">
                  <%= category.publish == 1 ? 'Yes' : 'No' %>
                </span>
              </td>
              <td><%= category.products.count %> products</td>
              <td><%= category.created_at.strftime('%Y-%m-%d %H:%M') %></td>
              <td>
                <div class="actions">
                  <%= link_to "Edit", edit_category_path(category), class: "btn btn-primary", style: "padding: 5px 10px; font-size: 12px;" %>
                  <%= link_to "Delete", category_path(category), method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger", style: "padding: 5px 10px; font-size: 12px;" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p style="text-align: center; padding: 40px; color: #666;">
        No categories yet. <%= link_to "Create your first category", new_category_path %>
      </p>
    <% end %>
  </div>
</div>
